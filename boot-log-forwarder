#!/usr/bin/env bash
# Forward readable journal messages into the Plymouth on-screen log panel.
# The complete journal remains on disk for troubleshooting after startup.
set -uo pipefail

command -v plymouth >/dev/null || exit 0
command -v journalctl >/dev/null || exit 0

# Never create a new Plymouth daemon if the splash has already exited.
for _ in {1..12}; do
    plymouth --ping >/dev/null 2>&1 && break
    sleep 0.25
done
plymouth --ping >/dev/null 2>&1 || exit 0

# -o cat omits verbose service/timestamp prefixes that previously overwhelmed
# the display at 1080p. The Plymouth theme also enforces a pixel-width limit.
journalctl -b -n 8 -f --no-pager -o cat 2>/dev/null | \
while IFS= read -r line; do
    plymouth --ping >/dev/null 2>&1 || break
    # Strip control bytes and bound unusually long entries before IPC.
    line=$(printf '%s' "$line" | LC_ALL=C tr -cd '\11\40-\176' | cut -c 1-84)
    [[ -n "$line" ]] || continue
    plymouth display-message --text="$line" >/dev/null 2>&1 || break
done
