# CaptainRatax Boot - Plymouth script theme
# Dual-profile splash for 1080p and 1440p, with live resolution-change handling.
# All geometry is recalculated when the Plymouth viewport changes after KMS starts.
# Log messages are delivered by Plymouth, not read directly by the theme.

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

background.original = Image("background.png");
background.sprite = Sprite();
background.sprite.SetPosition(0, 0, -1000);

logo.original = Image("logo.png");
logo.sprite = Sprite();

bar.original_track = Image("progress-track.png");
bar.original_fill = Image("progress-fill.png");
bar.track_sprite = Sprite();
bar.fill_sprite = Sprite();
bar.progress = 0;

panel.original = Image("logs-panel.png");
panel.sprite = Sprite();

log.count = 6;
log.entries = 0;
log.messages = [];
log.sprites = [];
for (i = 0; i < log.count; i++) {
    log.messages[i] = "";
    log.sprites[i] = Sprite();
}
log.messages[0] = "Waiting for boot messages...";
log.entries = 1;

password.original = Image("password-panel.png");
password.sprite = Sprite();
password.sprite.SetOpacity(0);
password.prompt = Sprite();
password.prompt.SetOpacity(0);
password.bullets = Sprite();
password.bullets.SetOpacity(0);
password.prompt_text = "";
password.bullets_text = "";
password.visible = 0;

screen.width = 0;
screen.height = 0;
screen.origin_x = 0;
screen.origin_y = 0;

# Create an accurate substring without relying on unsupported string methods.
fun take_characters(text, max_characters) {
    local.result = "";
    for (n = 0; n < max_characters; n++) {
        local.character = String(text).CharAt(n);
        if (!local.character) break;
        result += character;
    }
    return result;
}

# Text sprites do not clip to the panel. Measure the rendered result in pixels.
fun fitted_line(text) {
    local.candidate;
    local.limit = 110;
    local.prefix;
    if (text == "") return Image.Text("", 0.80, 0.92, 0.84, 1, log.font);

    candidate = Image.Text(text, 0.80, 0.92, 0.84, 1, log.font);
    if (candidate.GetWidth() <= log.max_width) return candidate;

    prefix = take_characters(text, limit);
    candidate = Image.Text(prefix + "...", 0.80, 0.92, 0.84, 1, log.font);
    while (candidate.GetWidth() > log.max_width && limit > 3) {
        limit = limit - 4;
        prefix = take_characters(text, limit);
        candidate = Image.Text(prefix + "...", 0.80, 0.92, 0.84, 1, log.font);
    }
    return candidate;
}

fun render_log_lines() {
    for (j = 0; j < log.count; j++) {
        log.sprites[j].SetPosition(log.x, log.y + j * log.step, 40);
        if (j < log.entries)
            log.sprites[j].SetImage(fitted_line(log.messages[j]));
        else
            log.sprites[j].SetImage(Image.Text("", 0.80, 0.92, 0.84, 1, log.font));
    }
}

fun render_progress() {
    local.filled_width = Math.Int(bar.width * Math.Clamp(bar.progress, 0, 1));
    if (filled_width > 0) {
        bar.fill_sprite.SetImage(bar.full_fill.Scale(filled_width, bar.height));
        bar.fill_sprite.SetOpacity(1);
    } else {
        bar.fill_sprite.SetOpacity(0);
    }
}

# Executed on startup and whenever the active Plymouth viewport changes.
fun update_layout() {
    screen.width = Window.GetWidth();
    screen.height = Window.GetHeight();
    screen.origin_x = Window.GetX();
    screen.origin_y = Window.GetY();

    if (screen.width <= 0 || screen.height <= 0) return;

    screen.scale = Math.Min(screen.width / 1920.0, screen.height / 1080.0);
    screen.center_x = screen.origin_x + screen.width / 2;

    # Preserve wallpaper aspect ratio at any framebuffer size.
    background.factor = Math.Max(screen.width / background.original.GetWidth(), screen.height / background.original.GetHeight());
    background.width = Math.Int(background.original.GetWidth() * background.factor);
    background.height = Math.Int(background.original.GetHeight() * background.factor);
    background.sprite.SetImage(background.original.Scale(background.width, background.height));
    background.sprite.SetPosition(screen.origin_x + (screen.width - background.width) / 2, screen.origin_y + (screen.height - background.height) / 2, -1000);

    # The compact profile avoids crowding smaller screens. Use current viewport
    # dimensions, not the originally detected firmware framebuffer geometry.
    if (screen.height <= 1120) {
        logo.size = Math.Int(Math.Min(screen.height * 0.16, screen.width * 0.115));
        logo.y = Math.Int(screen.origin_y + screen.height * 0.18);
        bar.width = Math.Int(screen.width * 0.25);
        bar.height = Math.Int(Math.Max(5, screen.height * 0.006));
        panel.width = Math.Int(screen.width * 0.42);
        panel.height = Math.Int(screen.height * 0.22);
        panel.gap = screen.height * 0.032;
        log.font = "Monospace 13";
    } else {
        # Slightly smaller than the v4 layout at 2560x1440.
        logo.size = Math.Int(Math.Min(screen.height * 0.19, screen.width * 0.15));
        logo.y = Math.Int(screen.origin_y + screen.height * 0.13);
        bar.width = Math.Int(screen.width * 0.27);
        bar.height = Math.Int(Math.Max(6, screen.height * 0.006));
        panel.width = Math.Int(screen.width * 0.49);
        panel.height = Math.Int(screen.height * 0.235);
        panel.gap = screen.height * 0.032;
        log.font = "Monospace 18";
    }

    # Keep the layout usable at smaller unexpected firmware resolutions.
    logo.size = Math.Int(Math.Max(72, logo.size));
    bar.width = Math.Int(Math.Min(bar.width, screen.width * 0.78));
    panel.width = Math.Int(Math.Min(panel.width, screen.width * 0.88));
    panel.height = Math.Int(Math.Min(panel.height, screen.height * 0.32));

    logo.sprite.SetImage(logo.original.Scale(logo.size, logo.size));
    logo.sprite.SetPosition(Math.Int(screen.center_x - logo.size / 2), logo.y, 10);

    bar.x = Math.Int(screen.center_x - bar.width / 2);
    bar.y = Math.Int(logo.y + logo.size + screen.height * 0.024);
    bar.track_sprite.SetImage(bar.original_track.Scale(bar.width, bar.height));
    bar.track_sprite.SetPosition(bar.x, bar.y, 20);
    bar.full_fill = bar.original_fill.Scale(bar.width, bar.height);
    bar.fill_sprite.SetPosition(bar.x, bar.y, 21);
    render_progress();

    panel.x = Math.Int(screen.center_x - panel.width / 2);
    panel.y = Math.Int(bar.y + panel.gap);
    panel.sprite.SetImage(panel.original.Scale(panel.width, panel.height));
    panel.sprite.SetPosition(panel.x, panel.y, 30);

    # Text is clipped to the actual pixel width of the rendered panel.
    log.x = Math.Int(panel.x + panel.width * 0.032);
    log.y = Math.Int(panel.y + panel.height * 0.20);
    log.step = Math.Int(panel.height * 0.105);
    log.max_width = Math.Int(panel.width * 0.92);
    render_log_lines();

    password.width = Math.Int(Math.Min(screen.width * 0.42, 660 * screen.scale));
    password.height = Math.Int(password.width * 170.0 / 660.0);
    password.x = Math.Int(screen.center_x - password.width / 2);
    password.y = Math.Int(screen.origin_y + screen.height * 0.38);
    password.sprite.SetImage(password.original.Scale(password.width, password.height));
    password.sprite.SetPosition(password.x, password.y, 1000);
    password.prompt.SetPosition(password.x + 25 * screen.scale, password.y + 30 * screen.scale, 1001);
    password.bullets.SetPosition(password.x + 25 * screen.scale, password.y + 85 * screen.scale, 1001);
    password.prompt.SetImage(Image.Text(password.prompt_text, 1, 1, 1, 1, log.font));
    password.bullets.SetImage(Image.Text(password.bullets_text, 0.3, 0.95, 0.5, 1, log.font));
}

# On some systems the splash starts at the firmware resolution and later
# switches to the native DRM/KMS resolution. A one-time layout is insufficient.
fun refresh_callback() {
    if (Window.GetWidth() != screen.width || Window.GetHeight() != screen.height || Window.GetX() != screen.origin_x || Window.GetY() != screen.origin_y)
        update_layout();
}
Plymouth.SetRefreshFunction(refresh_callback);

fun boot_progress_callback(duration, progress) {
    bar.progress = progress;
    render_progress();
}
Plymouth.SetBootProgressFunction(boot_progress_callback);

fun add_log_line(message) {
    if (!message || message == "") return;

    # Replace the placeholder as soon as the first real message arrives.
    if (log.entries == 1 && log.messages[0] == "Waiting for boot messages...")
        log.entries = 0;

    if (log.entries < log.count) {
        log.messages[log.entries] = message;
        log.entries++;
    } else {
        for (k = 0; k < log.count - 1; k++) log.messages[k] = log.messages[k + 1];
        log.messages[log.count - 1] = message;
    }
    render_log_lines();
}
Plymouth.SetDisplayMessageFunction(add_log_line);
Plymouth.SetUpdateStatusFunction(add_log_line);

fun display_password_callback(prompt, count) {
    password.sprite.SetOpacity(1);
    password.prompt_text = prompt;
    password.prompt.SetImage(Image.Text(password.prompt_text, 1, 1, 1, 1, log.font));
    password.prompt.SetOpacity(1);
    password.bullets_text = "";
    for (j = 0; j < Math.Min(count, 32); j++) password.bullets_text += "*";
    password.bullets.SetImage(Image.Text(password.bullets_text, 0.3, 0.95, 0.5, 1, log.font));
    password.bullets.SetOpacity(1);
}
fun display_question_callback(prompt, answer) {
    password.sprite.SetOpacity(1);
    password.prompt_text = prompt;
    password.bullets_text = answer;
    password.prompt.SetImage(Image.Text(password.prompt_text, 1, 1, 1, 1, log.font));
    password.bullets.SetImage(Image.Text(password.bullets_text, 0.3, 0.95, 0.5, 1, log.font));
    password.prompt.SetOpacity(1);
    password.bullets.SetOpacity(1);
}
fun display_normal_callback() {
    password.sprite.SetOpacity(0);
    password.prompt.SetOpacity(0);
    password.bullets.SetOpacity(0);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayQuestionFunction(display_question_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);

update_layout();
